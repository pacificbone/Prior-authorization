# Copy to .env.local. Never put credentials in browser code or commit them.
PORT=3000
# none | openai | bedrock. External AI accepts bundled synthetic cases ONLY.
AI_PROVIDER=none
AI_MODEL=
# Required for either external provider; generate a random >=32 character token.
# Enter it in the app's Connection panel for this browser session only.
TRIAL_ACCESS_TOKEN=
# Explicitly acknowledge approval for the synthetic-data trial connection.
AI_TRIAL_ENABLED=false
OPENAI_API_KEY=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# On Cloudflare/AWS, set the exact HTTPS origin, without a trailing slash.
APP_ORIGIN=
# There is deliberately NO switch to enable PHI in this trial.
